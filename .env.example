# JWT / Session secrets
NEXTAUTH_SECRET=change-me-in-production
ADMIN_PASSWORD_HASH=admin123

# ─── Turso Cloud Database (Required for persistence on Render free tier) ────────
# Sign up free at https://turso.tech (no credit card required).
# Create a database, then run:
#   turso db show <database-name> --url      -> copy libsql:// URL here
#   turso db tokens create <database-name>   -> copy token here
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# ─── Render Deployment ────────────────────────────────────────────────────────
# NOTE: Render free tier does NOT support persistent disks.
# Turso is used for production persistence. Leave this blank unless you upgrade.
RENDER_DISK_PATH=

# ─── Fly.io Deployment ─────────────────────────────────────────────────────────
# Set this on Fly.io to point to the persistent volume mount path.
# On Fly.io: /data
# Leave blank for local development.
FLY_VOLUME_PATH=

# ─── Platform Branding ───────────────────────────────────────────────────────
# The artist or celebrity name shown in all emails, subject lines, and UI.
# Change this to adapt the platform for any artist (e.g. "Taylor Swift").
ARTIST_NAME=Robert Plant

# Public app URL (used in email links and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up free at https://resend.com (no credit card required, 3,000 emails/month).
# Verify your domain, then create an API key and a sending email address.
RESEND_API_KEY=your-resend-api-key-here
# Must be a verified sender in your Resend dashboard (e.g. noreply@yourdomain.com).
# Use onboarding@resend.dev only for testing to your own email address.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Optional storage
BLOB_READ_WRITE_TOKEN=

# Ticketmaster Discovery API (optional — preferred, free, no artist account needed)
# Register free at https://developer.ticketmaster.com and copy your Consumer Key.
# When set, the platform imports live Robert Plant events from Ticketmaster.
TICKETMASTER_API_KEY=

# Bandsintown API (optional — fallback, requires Robert Plant's artist account key)
# The public REST API requires an authenticated app_id tied to the artist's
# Bandsintown for Artists account. Get it from:
# https://artists.bandsintown.com -> artist profile -> Settings -> General -> API
# Docs: https://help.artists.bandsintown.com/en/articles/9186477-api-documentation
# If not set, public and member pages use the official Bandsintown widget for live
# tour dates instead of fake data. Database sync and RSVP only work with an API key.
BANDSINTOWN_APP_ID=
